{
  "manifest_version": 3,
  "name": "FocusPulse",
  "version": "0.1.0",
  "description": "A self-reported productivity tracker with a persistent floating widget. Track your focus with color-coded activity states.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/widget.js",
        "content/dashboard.js"
      ],
      "css": [
        "content/widget.css"
      ],
      "run_at": "document_start"
    }
  ]
}
