{
  "manifest_version": 3,
  "name": "FocusPulse",
  "version": "0.1.0",
  "description": "A self-reported productivity tracker with a persistent floating widget. Track your focus with color-coded activity states.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/toasts.js",
        "content/settings.js",
        "content/idle.js",
        "content/about.js",
        "content/widget.js",
        "content/dashboard.js"
      ],
      "css": [
        "content/widget.css"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "focus-green": {
      "suggested_key": {
        "default": "Alt+1",
        "mac": "MacCtrl+1"
      },
      "description": "Log as Flow (Green)"
    },
    "focus-audio": {
      "suggested_key": {
        "default": "Alt+2",
        "mac": "MacCtrl+2"
      },
      "description": "Log as Noise (Orange)"
    },
    "focus-distracted": {
      "suggested_key": {
        "default": "Alt+3",
        "mac": "MacCtrl+3"
      },
      "description": "Log as Lost (Red)"
    },
    "focus-break": {
      "suggested_key": {
        "default": "Alt+4",
        "mac": "MacCtrl+4"
      },
      "description": "Log as Rest (Blue)"
    }
  }
}
